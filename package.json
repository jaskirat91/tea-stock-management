{
  "name": "tea-stock-management",
  "version": "1.0.0",
  "description": "Keyboard-First Tea Stock Management System",
  "author": "Tea Stock Management",
  "main": "dist/main/app/main/index.js",
  "scripts": {
    "dev": "concurrently -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.node.json && NODE_ENV=development electron .\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.node.json && NODE_ENV=development electron .",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "rebuild": "electron-rebuild",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "clsx": "^2.1.0",
    "fuse.js": "^7.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "keytar": "^7.9.0",
    "lucide-react": "^0.300.0",
    "moment": "^2.30.1",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.0",
    "reflect-metadata": "^0.2.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.2.1",
    "typeorm": "^0.3.20",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.5.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20.10.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "^8.4.33",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.teastock.app",
    "productName": "Tea Stock Management",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tea Stock Management"
    }
  }
}
